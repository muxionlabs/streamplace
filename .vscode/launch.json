{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streamplace (linux)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build-linux-amd64/libstreamplace",
      "preLaunchTask": "build-libstreamplace",
      "args": [
        "--broadcaster-host=127.0.0.1:38080",
        "--no-firehose",
        "--wide-open",
        "--livepeer-gateway-url=http://10.10.7.61:8081",
        "--livepeer-ai-processing",
        "--livepeer-ai-capability=transcription",
        "--livepeer-ai-enable-data-output",
        "--livepeer-ai-enable-video-egress=false"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GOTOOLCHAIN": "auto",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build-linux-amd64/lib",
        "ELECTRON_DISABLE_SANDBOX": "1",
        "SP_DEV_FRONTEND_PROXY": "http://127.0.0.1:38081",
        "SP_DEV_PUBLIC_OAUTH": "true"
      },
      "console": "integratedTerminal"
    }, //https://gateway-usa.muxion.video/g
    {
      "name": "Run Streamplace App Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "xvfb-run --auto-servernum pnpm run start"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ELECTRON_DISABLE_SANDBOX": "1"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run Streamplace (darwin)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "./build-darwin-arm64/streamplace --broadcaster-host=127.0.0.1:38080 --livepeer-gateway-url=https://10.10.7.61:8081"
      ],
      "cwd": "${workspaceFolder}",
      "args": ["--no-firehose", "--wide-open"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run Streamplace + App Dev Server",
      "configurations": [
        "Run Streamplace (linux)",
        "Run Streamplace App Dev Server"
      ]
    }
  ]
}
